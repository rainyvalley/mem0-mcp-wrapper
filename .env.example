# Copy to secrets.env (same dir as docker-compose.yml) and fill in.
# chmod 600 secrets.env

# REQUIRED: bearer for the mem0 REST API. The MCP wrapper sends it on every
# call; Open WebUI's filter valve needs the same value.
MEM0_API_KEY=change-me-to-a-long-random-string

# REQUIRED: bearer for the MCP endpoint itself (what MCP clients send).
MCP_BEARER_TOKEN=change-me-to-another-long-random-string

# OPTIONAL: fact extraction via Ollama Cloud (skips the local Ollama LLM).
# OLLAMA_API_KEY=your-ollama-cloud-key

# Generate values on a machine with openssl:
#   openssl rand -hex 24